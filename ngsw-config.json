{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.json",
          "/*.css",
          "/*.js",
          "/favicon.ico",
          "/icon_x32.png",
          "/icon_x180.png",
          "/icon_x192.png",
          "/icon_x512.png",
          "/icon_maskable_x192.png",
          "/icon_maskable_x512.png"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/media/**",
          "/apple-splash/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|ico|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
