
# =============================================================================
# Fiovi PWA — configuración de build
# =============================================================================

# ─── Requeridas ──────────────────────────────────────────────────────────────

# URL base del backend learnex. Sin slash final. Fiovi arma sus paths
API_BASE_URL=https://api.yangpimpollo.com

# Versión visible del cliente.
APP_VERSION=1.2.1

# draft para los snaphot | dev tools modo desarrollo
DRAFT_ENABLED=true
DEV_TOOLS=true

# public capcha key
CAPTCHA_PROVIDER=turnstile
PUBLIC_CAPTCHA_SITE_KEY=



# =============================================================================
# Comandos comunes
# =============================================================================
#   npm run dev          Dev server (preflight: build-env)
#   npm run build-env    Regenera src/environments/ desde .env (manual)
#   npm test             Vitest sobre tests/
#   npm run lint         ESLint
#   npm run format       Prettier write
#   npm run format       Prettier write
#   npm run build        Bundle producción (preflight: build-env)
#
# Servir el build localmente para smoke-test:
#   npx http-server dist/fiovi/browser -p 8081
#   npx serve -s dist/fiovi/browser -l 8081
#
# Deploy Docker:
#   1. Clonar repo
#   2. Copiar .env.example a .env y llenar los valores
#   3. Levantar con:  
#       docker compose up -d --build
#
#   4. cloudflared tunnel run lugia

